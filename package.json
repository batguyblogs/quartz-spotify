{
  "name": "quartz-spotify",
  "version": "0.1.0",
  "description": "A Spotify now playing widget that shows the currently playing / past played track Forked and modified to work with quartz from Om-Thorat's sptify-now-playing",
  "type": "module",
  "license": "MIT",
  "author": "batguyblogs",
  "homepage": "https://batguyblogs.github.io/Blog-Page/",
  "repository": {
    "type": "git",
    "url": "https://github.com/batguyblogs/quartz-spotify"
  },
  "keywords": [
    "quartz",
    "quartz-plugin",
    "plugin-template",
    "remark",
    "rehype",
    "mdast",
    "hast"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format && npm run test",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "preact": "^10.0.0",
    "vfile": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": false
    },
    "vfile": {
      "optional": true
    }
  },
  "dependencies": {
    "@quartz-community/types": "^0.3.0",
    "@quartz-community/utils": "github:quartz-community/utils"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "mdast-util-find-and-replace": "^3.0.2",
    "preact": "^10.28.2",
    "prettier": "^3.6.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sass": "^1.97.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "vitest": "^2.1.9"
  },
  "quartz": {
    "name": "quartz-spotify",
    "displayName": "Spotify Now Playing",
    "category": [
      "component"
    ],
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {
      "endpoint": "https://spotifylive-kappa.vercel.app/",
      "refreshInterval": 30000
    },
    "optionSchema": {
      "endpoint": {
        "type": "string"
      },
      "refreshInterval": {
        "type": "number"
      }
    },
    "components": {
      "SpotifyNowPlaying": {
        "displayName": "Spotify Now Playing",
        "defaultPosition": "right",
        "defaultPriority": 50
      }
    }
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}